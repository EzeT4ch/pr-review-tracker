<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>prt</AssemblyName>
    <RootNamespace>Prt.Cli</RootNamespace>
    <Version>0.3.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>prt</ToolCommandName>
    <PackageId>PrReviewTracker</PackageId>
    <Description>Trazabilidad de revisiones de PRs de Bitbucket con agentes CLI y export a Obsidian.</Description>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prt.Core\Prt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

</Project>
